{
  "name": "doorstep",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @doorstep/app",
    "build": "npm run build -w @doorstep/app",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "dev:lan": "npm run dev:lan -w @doorstep/app",
    "deploy": "npm run deploy -w @doorstep/app",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "backup": "node tools/backup.mjs",
    "backup:media": "node tools/backup.mjs --media",
    "restore": "node tools/restore.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.129.0"
  }
}
