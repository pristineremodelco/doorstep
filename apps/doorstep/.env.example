# Copy to .env.local. With the Supabase pair unset, Doorstep runs entirely on
# this machine: record, review and rewatch all work and nothing is uploaded.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The public half of the VAPID keypair. Safe in a browser: it only lets a push
# service confirm that a notification came from this server.
VITE_VAPID_PUBLIC_KEY=
